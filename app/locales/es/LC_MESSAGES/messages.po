#: app/templates/setup.html:2
msgid "Setup"
msgstr "Configuración"

#: app/templates/setup.html:5
#, python-format
msgid "Welcome to %(app_name)s"
msgstr "Bienvenido a %(app_name)s"

#: app/templates/setup.html:6
msgid "Create the initial admin account to get started."
msgstr "Cree la cuenta de administrador inicial para comenzar."

#: app/templates/setup.html:9
msgid "Before you continue"
msgstr "Antes de continuar"

#: app/templates/setup.html:11
msgid ""
"Start the app (for example with Docker Compose) and open the container or"
" server logs."
msgstr ""
"Inicie la aplicación (por ejemplo con Docker Compose) y abra los "
"registros del contenedor o del servidor."

#: app/templates/setup.html:12
msgid "Find the one-time setup token printed at startup (a long random string)."
msgstr ""
"Busque en los registros el token de configuración único que se muestra al"
" iniciar (cadena aleatoria larga)."

#: app/templates/setup.html:13
msgid "Enter that token below together with your admin account details."
msgstr ""
"Introduzca ese token a continuación junto con los datos de su cuenta de "
"administrador."

#: app/templates/setup.html:15
msgid ""
"If you restart the app before finishing setup, a new token is generated —"
" check the logs again."
msgstr ""
"Si reinicia la aplicación antes de terminar la configuración, se generará"
" un nuevo token — consulte los registros de nuevo."

#: app/templates/setup.html:25
msgid "Setup token"
msgstr "Token de configuración"

#: app/templates/setup.html:27
msgid "From the container or server logs, not shown on this page."
msgstr ""
"En los registros del contenedor o del servidor, no se muestra en esta "
"página."

#: app/templates/setup.html:34
msgid "Admin email"
msgstr "Correo del administrador"

#: app/templates/setup.html:38
msgid "Admin password"
msgstr "Contraseña del administrador"

#: app/templates/setup.html:41
msgid "Create admin & continue"
msgstr "Crear administrador y continuar"

